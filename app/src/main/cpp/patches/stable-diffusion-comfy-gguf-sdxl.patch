+static bool apply_comfy_original_shape(const gguf_context* ctx,
+                                       TensorStorage& tensor_storage,
+                                       std::string* error) {
+    static const std::string key_prefix = "comfy.gguf.orig_shape.";
+    const std::string key               = key_prefix + tensor_storage.name;
+    const int64_t key_id                = gguf_find_key(ctx, key.c_str());
+    if (key_id < 0) {
+        return true;
+    }
+
+    if (gguf_get_kv_type(ctx, key_id) != GGUF_TYPE_ARRAY ||
+        gguf_get_arr_type(ctx, key_id) != GGUF_TYPE_INT32) {
+        set_error(error, "invalid original-shape metadata for tensor '" + tensor_storage.name + "'");
+        return false;
+    }
+
+    const size_t n_dims = gguf_get_arr_n(ctx, key_id);
+    if (n_dims == 0 || n_dims > SD_MAX_DIMS) {
+        set_error(error, "unsupported original-shape rank for tensor '" + tensor_storage.name + "'");
+        return false;
+    }
+
+    const int32_t* original_shape = static_cast<const int32_t*>(gguf_get_arr_data(ctx, key_id));
+    if (original_shape == nullptr) {
+        set_error(error, "missing original-shape data for tensor '" + tensor_storage.name + "'");
+        return false;
+    }
+
+    int64_t logical_elements = 1;
+    for (size_t i = 0; i < n_dims; ++i) {
+        const int32_t dim = original_shape[i];
+        if (dim <= 0 || logical_elements > std::numeric_limits<int64_t>::max() / dim) {
+            set_error(error, "invalid original shape for tensor '" + tensor_storage.name + "'");
+            return false;
+        }
+        logical_elements *= dim;
+    }
+    if (logical_elements != tensor_storage.nelements()) {
+        set_error(error, "original-shape element count mismatch for tensor '" + tensor_storage.name + "'");
+        return false;
+    }
+
+    tensor_storage.storage_row_size = tensor_storage.ne[0];
+    std::fill(std::begin(tensor_storage.ne), std::end(tensor_storage.ne), 1);
+    tensor_storage.n_dims = static_cast<int>(n_dims);
+    for (size_t i = 0; i < n_dims; ++i) {
+        // ComfyUI metadata uses framework order (out, in, kH, kW); ggml uses the
+        // reverse order (kW, kH, in, out).
+        tensor_storage.ne[i] = original_shape[n_dims - 1 - i];
+    }
+    return true;
+}
